{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "X Pulse · 商机雷达",
  "version": "3.0.0",
  "description": "浏览 X 时显示粉丝数，并手动扫描已加载评论中的产品商机。",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "X Pulse · 商机雷达",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.bundle.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
